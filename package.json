{
  "dependencies": {
    "pannellum": "^2.5.7"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"npm run dev:css\"",
    "dev:css": "npx tailwindcss -i ./css/input.css -o ./css/output.css --watch",
    "build": " npx tailwindcss -i ./css/input.css -o ./css/output.css && vite build"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^10.0.4",
    "daisyui": "^5.7.9",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0"
  }
}
